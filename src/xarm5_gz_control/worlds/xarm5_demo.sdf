<?xml version="1.0" ?>
<!--
  xArm5 Demo World — Gazebo Harmonic (SDF 1.9)
  =============================================
  Scene layout:
    - Ground plane
    - Work table (robot base sits on top at z = 1.021 m)
    - RED pad   = pick zone  (left / +Y of robot, x=0.30 y=+0.25)
    - GREEN pad = place zone (right / -Y of robot, x=0.30 y=-0.25)
    - ORANGE box = demo object (starts on pick zone)

  Physics: Bullet Featherstone for accurate articulated body dynamics
-->
<sdf version="1.9">
  <world name="xarm5_demo">

    <!-- Required Gazebo Harmonic system plugins -->
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-contact-system"
            name="gz::sim::systems::Contact"/>

    <!-- Lighting -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
    </light>

    <!-- Ground plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="col">
          <geometry>
            <plane><normal>0 0 1</normal><size>20 20</size></plane>
          </geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="vis">
          <geometry>
            <plane><normal>0 0 1</normal><size>20 20</size></plane>
          </geometry>
          <material>
            <ambient>0.35 0.35 0.35 1</ambient>
            <diffuse>0.4 0.4 0.4 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!--
      Work Table
      The robot base is spawned at z=1.021 so its base rests on the table top.
      Table: 1.4m wide × 0.9m deep × 1.021m tall
      Centred at x=0, y=-0.3 so the work surface extends in front of the arm.
    -->
    <model name="work_table">
      <static>true</static>
      <pose>0 -0.3 0 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <pose>0 0 0.5105 0 0 0</pose>
          <geometry>
            <box><size>1.4 0.9 1.021</size></box>
          </geometry>
        </collision>
        <visual name="vis">
          <pose>0 0 0.5105 0 0 0</pose>
          <geometry>
            <box><size>1.4 0.9 1.021</size></box>
          </geometry>
          <material>
            <ambient>0.55 0.40 0.25 1</ambient>
            <diffuse>0.65 0.50 0.30 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!--
      Pick Zone Marker — RED flat pad on table surface (left / +Y)
      Robot-frame coordinates: x=0.30, y=+0.25, z=0.0 (table level)
      World z = 1.021 (table top) + 0.002 (half pad thickness)
    -->
    <model name="pick_zone">
      <static>true</static>
      <pose>0.30 0.25 1.023 0 0 0</pose>
      <link name="link">
        <visual name="vis">
          <geometry><box><size>0.16 0.16 0.004</size></box></geometry>
          <material>
            <ambient>0.85 0.08 0.08 0.9</ambient>
            <diffuse>0.95 0.10 0.10 0.9</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!--
      Place Zone Marker — GREEN flat pad on table surface (right / -Y)
      Robot-frame coordinates: x=0.30, y=-0.25, z=0.0
    -->
    <model name="place_zone">
      <static>true</static>
      <pose>0.30 -0.25 1.023 0 0 0</pose>
      <link name="link">
        <visual name="vis">
          <geometry><box><size>0.16 0.16 0.004</size></box></geometry>
          <material>
            <ambient>0.08 0.75 0.08 0.9</ambient>
            <diffuse>0.10 0.85 0.10 0.9</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!--
      Demo Object — ORANGE cube sitting on pick zone.
      The demo sequence moves the arm to simulate picking/placing this cube.
      It has physics so it can be seen resting on the table surface.
      Size: 6 cm cube.  Bottom face at z = 1.021, centre at z = 1.051.
    -->
    <model name="demo_cube">
      <static>false</static>
      <pose>0.30 0.25 1.051 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.15</mass>
          <inertia>
            <ixx>0.000038</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.000038</iyy><iyz>0</iyz>
            <izz>0.000038</izz>
          </inertia>
        </inertial>
        <collision name="col">
          <geometry><box><size>0.06 0.06 0.06</size></box></geometry>
          <surface>
            <friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="vis">
          <geometry><box><size>0.06 0.06 0.06</size></box></geometry>
          <material>
            <ambient>0.95 0.55 0.0 1</ambient>
            <diffuse>1.0 0.65 0.0 1</diffuse>
            <specular>0.3 0.25 0.0 1</specular>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
