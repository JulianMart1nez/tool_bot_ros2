<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd"
            schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>xarm5_gz_control</name>
  <version>2.0.0</version>
  <description>
    xArm5 Gazebo Harmonic simulation with MoveIt2, keyboard teleoperation,
    and a pick-and-place demo sequence. Pure Python — no C++ compilation
    required. Depends only on apt-installed ROS2 Jazzy packages.
  </description>
  <maintainer email="user@example.com">User</maintainer>
  <license>BSD</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <!-- These are all installed via apt on your system -->
  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>trajectory_msgs</depend>
  <depend>control_msgs</depend>
  <depend>moveit_msgs</depend>
  <depend>xacro</depend>
  <depend>robot_state_publisher</depend>
  <depend>joint_state_broadcaster</depend>
  <depend>joint_trajectory_controller</depend>
  <depend>controller_manager</depend>
  <depend>ros_gz_sim</depend>
  <depend>ros_gz_bridge</depend>
  <depend>gz_ros2_control</depend>
  <depend>moveit_ros_move_group</depend>
  <depend>moveit_ros_planning_interface</depend>
  <depend>moveit_servo</depend>
  <depend>moveit_py</depend>
  <depend>tf2_ros</depend>
  <depend>rviz2</depend>

  <!-- xarm description and moveit config (source packages, pure XML/Python) -->
  <depend>xarm_description</depend>
  <depend>xarm_moveit_config</depend>
  <depend>uf_ros_lib</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
